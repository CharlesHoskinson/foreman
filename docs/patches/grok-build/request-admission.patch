+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicUsize, Ordering},
+};
+
+use super::*;
+use crate::admission::{
+    RequestAdmission, RequestAdmissionDescriptor, RequestTransport, SharedRequestAdmission,
+};
+use axum::Router;
+use xai_grok_sampling_types::RequestAdmissionDenial;
+
+struct RecordingAdmission {
+    observed: Arc<Mutex<Vec<RequestAdmissionDescriptor>>>,
+    denial: Option<RequestAdmissionDenial>,
+}
+
+impl RequestAdmission for RecordingAdmission {
+    fn admit(
+        &self,
+        request: &RequestAdmissionDescriptor,
+    ) -> std::result::Result<(), RequestAdmissionDenial> {
+        self.observed.lock().unwrap().push(request.clone());
+        self.denial.map_or(Ok(()), Err)
+    }
+}
+
+struct Fixture {
+    url: String,
+    received: Arc<AtomicUsize>,
+    server: tokio::task::JoinHandle<()>,
+}
+
+impl Fixture {
+    async fn start() -> Self {
+        let received = Arc::new(AtomicUsize::new(0));
+        let count = received.clone();
+        let app = Router::new().fallback(move || {
+            let count = count.clone();
+            async move {
+                count.fetch_add(1, Ordering::SeqCst);
+                "ok"
+            }
+        });
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}/sample", listener.local_addr().unwrap());
+        let server = tokio::spawn(async move {
+            axum::serve(listener, app).await.unwrap();
+        });
+        Self {
+            url,
+            received,
+            server,
+        }
+    }
+}
+
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        self.server.abort();
+    }
+}
+
+fn config(hook: Option<SharedRequestAdmission>) -> SamplerConfig {
+    SamplerConfig {
+        request_admission: hook,
+        ..Default::default()
+    }
+}
+
+fn hook(
+    denial: Option<RequestAdmissionDenial>,
+) -> (
+    SharedRequestAdmission,
+    Arc<Mutex<Vec<RequestAdmissionDescriptor>>>,
+) {
+    let observed = Arc::new(Mutex::new(Vec::new()));
+    (
+        SharedRequestAdmission::new(Arc::new(RecordingAdmission {
+            observed: observed.clone(),
+            denial,
+        })),
+        observed,
+    )
+}
+
+async fn dispatch(
+    client: &SamplingClient,
+    fixture: &Fixture,
+    transport: RequestTransport,
+    body: reqwest::Body,
+) -> Result<reqwest::Response> {
+    let request = reqwest::Client::new()
+        .post(&fixture.url)
+        .header(AUTHORIZATION, "Bearer synthetic-secret-never-disclose")
+        .body(body)
+        .build()
+        .unwrap();
+    match transport {
+        RequestTransport::NonStreaming => client.send(request).await,
+        RequestTransport::Streaming => {
+            let mut timing = StreamSpanTiming::start(crate::span_timing::Region::from_span(
+                tracing::Span::none(),
+            ));
+            client.execute_stream_request(request, &mut timing).await
+        }
+    }
+}
+
+#[tokio::test]
+async fn admission_denial_sends_zero_http_for_both_execution_paths() {
+    let fixture = Fixture::start().await;
+    let (hook, observed) = hook(Some(RequestAdmissionDenial::UnsupportedHardLimits));
+    let cfg = config(Some(hook));
+    for transport in [RequestTransport::NonStreaming, RequestTransport::Streaming] {
+        for force_http1 in [false, true] {
+            let mut reconstructed = cfg.clone();
+            reconstructed.force_http1 = force_http1;
+            let client = SamplingClient::new(reconstructed).unwrap().clone();
+            let result = dispatch(&client, &fixture, transport, "secret-prompt".into()).await;
+            assert!(
+                matches!(
+                    result,
+                    Err(SamplingError::RequestAdmissionDenied(
+                        RequestAdmissionDenial::UnsupportedHardLimits
+                    ))
+                ),
+                "request must be refused before HTTP execution"
+            );
+        }
+    }
+    assert_eq!(fixture.received.load(Ordering::SeqCst), 0);
+    assert_eq!(
+        observed.lock().unwrap().len(),
+        4,
+        "clones must share the same authority"
+    );
+}
+
+#[tokio::test]
+async fn admission_absent_or_allowing_preserves_both_http_paths() {
+    let fixture = Fixture::start().await;
+    let (hook, observed) = hook(None);
+    for configured in [None, Some(hook)] {
+        let client = SamplingClient::new(config(configured)).unwrap();
+        for transport in [RequestTransport::NonStreaming, RequestTransport::Streaming] {
+            assert!(
+                dispatch(&client, &fixture, transport, "payload".into())
+                    .await
+                    .unwrap()
+                    .status()
+                    .is_success()
+            );
+        }
+    }
+    assert_eq!(fixture.received.load(Ordering::SeqCst), 4);
+    assert_eq!(observed.lock().unwrap().len(), 2);
+}
+
+#[tokio::test]
+async fn admission_descriptor_binds_exact_body_without_disclosing_content() {
+    let fixture = Fixture::start().await;
+    let (hook, observed) = hook(Some(RequestAdmissionDenial::ResourceExhausted));
+    let client = SamplingClient::new(config(Some(hook.clone()))).unwrap();
+    for body in ["secret-a", "secret-b"] {
+        let error = dispatch(
+            &client,
+            &fixture,
+            RequestTransport::NonStreaming,
+            body.into(),
+        )
+        .await
+        .unwrap_err();
+        assert!(!format!("{error:?} {error}").contains("secret"));
+    }
+    let observed = observed.lock().unwrap();
+    let [first, second] = observed.as_slice() else {
+        panic!("two descriptors expected")
+    };
+    assert_eq!(first.encoded_body_bytes, Some(8));
+    assert_eq!(second.encoded_body_bytes, Some(8));
+    assert_eq!(
+        first.body_blake3,
+        Some(*blake3::hash(b"secret-a").as_bytes())
+    );
+    assert_ne!(first.body_blake3, second.body_blake3);
+    assert!(!format!("{observed:?} {hook:?}").contains("secret"));
+}
+
+#[tokio::test]
+async fn admission_streamed_body_has_no_invented_length_or_digest() {
+    let fixture = Fixture::start().await;
+    let (hook, observed) = hook(Some(RequestAdmissionDenial::AuthorityUnavailable));
+    let client = SamplingClient::new(config(Some(hook))).unwrap();
+    let body = reqwest::Body::wrap_stream(futures_util::stream::iter([Ok::<_, std::io::Error>(
+        "body",
+    )]));
+    assert!(
+        dispatch(&client, &fixture, RequestTransport::Streaming, body)
+            .await
+            .is_err()
+    );
+    let observed = observed.lock().unwrap();
+    let [descriptor] = observed.as_slice() else {
+        panic!("one descriptor expected")
+    };
+    assert_eq!(descriptor.transport, RequestTransport::Streaming);
+    assert_eq!(descriptor.encoded_body_bytes, None);
+    assert_eq!(descriptor.body_blake3, None);
+    assert_eq!(fixture.received.load(Ordering::SeqCst), 0);
+}
+
+#[test]
+fn admission_hook_is_not_serialized_or_recovered_from_untrusted_config() {
+    let (hook, _) = hook(Some(RequestAdmissionDenial::UnsupportedHardLimits));
+    let mut value = serde_json::to_value(config(Some(hook))).unwrap();
+    assert!(value.get("request_admission").is_none());
+    value["request_admission"] = serde_json::json!({"allow": true});
+    let recovered: SamplerConfig = serde_json::from_value(value).unwrap();
+    assert!(recovered.request_admission.is_none());
+}
+
+#[test]
+fn admission_denial_remains_typed_nonretryable_and_roundtrips() {
+    for reason in [
+        RequestAdmissionDenial::UnsupportedHardLimits,
+        RequestAdmissionDenial::ResourceExhausted,
+        RequestAdmissionDenial::AuthorityUnavailable,
+    ] {
+        let error = SamplingError::RequestAdmissionDenied(reason);
+        assert!(!error.is_retryable());
+        assert!(error.is_retry_vetoed());
+        assert!(
+            matches!(crate::classify_error(&error, 0, 15, 2), crate::RetryDecision::Fatal(SamplingError::RequestAdmissionDenied(actual)) if actual == reason)
+        );
+        let info = crate::SamplingErrorInfo::from(&error);
+        assert!(!info.is_retryable);
+        assert_eq!(
+            info.kind,
+            crate::SamplingErrorKind::RequestAdmissionDenied(reason)
+        );
+        let decoded: crate::SamplingErrorInfo =
+            serde_json::from_value(serde_json::to_value(info).unwrap()).unwrap();
+        assert_eq!(
+            decoded.kind,
+            crate::SamplingErrorKind::RequestAdmissionDenied(reason)
+        );
+        assert!(
+            matches!(stream_collect_error(decoded), SamplingError::RequestAdmissionDenied(actual) if actual == reason)
+        );
+    }
+}
+
+#[tokio::test]
+async fn admission_actor_denial_is_terminal_despite_retry_allowance() {
+    let fixture = Fixture::start().await;
+    let (hook, observed) = hook(Some(RequestAdmissionDenial::UnsupportedHardLimits));
+    let mut cfg = config(Some(hook));
+    cfg.base_url = fixture.url.clone();
+    cfg.model = "local-fixture-model".into();
+    cfg.max_retries = Some(15);
+    let (events, mut receiver) = tokio::sync::mpsc::unbounded_channel();
+    let handle = crate::SamplerActor::spawn(cfg, crate::RetryPolicy::default(), events);
+    let result = tokio::time::timeout(
+        std::time::Duration::from_secs(2),
+        handle.submit_and_collect(
+            crate::RequestId::from("admission-fixture"),
+            ConversationRequest::default(),
+        ),
+    )
+    .await
+    .expect("admission denial must not enter retry backoff");
+    assert!(matches!(
+        result,
+        Err(SamplingError::RequestAdmissionDenied(
+            RequestAdmissionDenial::UnsupportedHardLimits
+        ))
+    ));
+    assert_eq!(observed.lock().unwrap().len(), 1);
+    assert_eq!(fixture.received.load(Ordering::SeqCst), 0);
+    while let Ok(event) = receiver.try_recv() {
+        assert!(!matches!(event, crate::SamplingEvent::Retrying { .. }));
+    }
+}
+
+#[test]
+fn admission_coarse_error_kind_remains_a_closed_denial() {
+    let parsed: crate::SamplingErrorKind = "request_admission_denied".parse().unwrap();
+    assert_eq!(
+        parsed,
+        crate::SamplingErrorKind::RequestAdmissionDenied(
+            RequestAdmissionDenial::AuthorityUnavailable
+        )
+    );
+}
