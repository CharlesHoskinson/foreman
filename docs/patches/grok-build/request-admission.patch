@@ -0,0 +1,58 @@
+//! Optional trusted request veto at the sampler HTTP boundary.
+//!
+//! This is not a token or monetary budget implementation. An allow decision does
+//! not establish one physical transmission: redirects, transport replays, and
+//! server-side work need separate qualification. A denial prevents this call to
+//! the HTTP executor. Startup/authentication work before this boundary is outside
+//! its scope. Hosts must install the hook on every client they intend to govern.
+
+use std::{fmt, sync::Arc};
+
+pub use xai_grok_sampling_types::RequestAdmissionDenial;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RequestTransport {
+    Streaming,
+    NonStreaming,
+}
+
+/// Safe evidence about the final outgoing body, after any compression.
+/// No URL, headers, credentials or body contents are exposed.
+/// Both body fields are `None` when the body is not available as buffered bytes;
+/// neither absence nor a byte count is a token estimate or billing guarantee.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RequestAdmissionDescriptor {
+    pub transport: RequestTransport,
+    pub encoded_body_bytes: Option<usize>,
+    pub body_blake3: Option<[u8; 32]>,
+}
+
+/// A trusted host's bounded, synchronous local admission decision.
+/// Implementations must not perform blocking or network I/O. A future remote
+/// authority requires separately qualified asynchronous wiring and permits.
+pub trait RequestAdmission: Send + Sync {
+    fn admit(&self, request: &RequestAdmissionDescriptor) -> Result<(), RequestAdmissionDenial>;
+}
+
+/// In-memory clones share the same authority. Debug never formats the authority.
+#[derive(Clone)]
+pub struct SharedRequestAdmission(Arc<dyn RequestAdmission>);
+
+impl SharedRequestAdmission {
+    pub fn new(admission: Arc<dyn RequestAdmission>) -> Self {
+        Self(admission)
+    }
+
+    pub(crate) fn admit(
+        &self,
+        request: &RequestAdmissionDescriptor,
+    ) -> Result<(), RequestAdmissionDenial> {
+        self.0.admit(request)
+    }
+}
+
+impl fmt::Debug for SharedRequestAdmission {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("SharedRequestAdmission(<opaque>)")
+    }
+}
diff --git a/crates/codegen/xai-grok-sampler/src/request_admission_tests.rs b/crates/codegen/xai-grok-sampler/src/request_admission_tests.rs
