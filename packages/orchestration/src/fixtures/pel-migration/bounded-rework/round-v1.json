{
  "schemaVersion": 1,
  "runId": "legacy-bounded-rework",
  "laneId": "worker",
  "attemptId": 1,
  "mode": "round",
  "commandArgv": [
    "grok",
    "--prompt-file",
    "bounded-rework.md",
    "-m",
    "grok-4.6",
    "--allow",
    "Write",
    "--allow",
    "Edit",
    "--output-format",
    "plain",
    "--cwd",
    "/legacy/workspace",
    "--no-leader"
  ],
  "gateCommand": "/usr/bin/git -c core.fsmonitor=false diff --no-ext-diff --no-textconv --check",
  "reportPath": "reports/bounded-rework.md",
  "reportBaseline": {
    "_tag": "Absent"
  }
}
