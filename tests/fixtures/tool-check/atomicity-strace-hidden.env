# Sourced to rebuild PATH with strace absent, without touching the host
# install. Portable: walks the real PATH at run time and symlinks every
# other resolvable executable by basename into a private shadow directory,
# deliberately skipping strace. No file outside $TMPDIR is modified.
_shadow="$(mktemp -d "${TMPDIR:-/tmp}/fm-tc-nostrace.XXXXXX")"
IFS=: read -ra _dirs <<< "$PATH"
declare -A _seen
for _d in "${_dirs[@]}"; do
  [[ -d "$_d" ]] || continue
  for _f in "$_d"/*; do
    [[ -f "$_f" && -x "$_f" ]] || continue
    _b="$(basename "$_f")"
    [[ "$_b" == "strace" ]] && continue
    [[ -n "${_seen[$_b]:-}" ]] && continue
    _seen[$_b]=1
    ln -s "$_f" "$_shadow/$_b" 2>/dev/null || true
  done
done
export PATH="$_shadow"
