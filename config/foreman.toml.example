# Copy to <target-repo>/.foreman/config.toml

mode = "soft"   # soft | hard

[worker]
vendor = "grok"       # claude | codex | grok — must differ from orchestrator in hard mode
model  = "grok-4.5"

[audit]
vendor = "codex"      # default auditor family (must differ from worker)
model  = "gpt-5.6-sol"  # GPT-5.6 Sol via Codex CLI (codex-auditor in soft mode)
# empty vendor = auto: prefer codex when worker is grok

[checks]
command = ""          # empty = auto-detect package.json / pyproject.toml

[limits]
max_rework_rounds = 3
round_timeout_min = 30
max_tokens_per_round = 400000

[gate]
forbidden_paths = [
  "tests/**",
  ".github/**",
  ".foreman/**",
  "*.lock",
  "package-lock.json",
]
hash_paths = ["tests/**", ".github/**"]

[durable]              # durable-lanes instrumentation (lane-run.sh / watch.sh)
# merge_base_max_commits = 50   # merge-gate staleness bound (commits behind origin/main)
enabled = true            # enforce round-owned dispatch at the lane-run.sh boundary
checkpoint_interval = 20   # seconds
heartbeat_interval = 30
stall_warn = 300
stall_dead = 900
resume_max_attempts = 2   # v0.2.5 T8: lane-supervise.sh bounded auto-resume cap (env: RESUME_MAX_ATTEMPTS)
# v0.2.5 T4b: watch.sh v2 typed-state phase thresholds (stall_warn/stall_dead
# above stay as the v1-compatibility fallback and the shared DEAD bound).
# starting_stale = 90    # seconds a lane may sit in STARTING before STALLED (env: STARTING_STALE)
# impl_stale = 300       # seconds a lane may sit in RUNNING_IMPL before STALLED (env: IMPL_STALE)
# verify_stale = 600     # seconds a lane may sit in VERIFYING before STALLED (env: VERIFY_STALE)
# grace = 10             # seconds of grace after entering a new phase before STALLED can fire (env: WATCH_GRACE)

[nats]                 # JetStream transport (skills/foreman/scripts/nats/, lib/nats-bridge.sh)
url = "nats://127.0.0.1:4222"
store_dir = "~/.foreman/nats-store"
stream = "FOREMAN"
subject_prefix = "foreman"
