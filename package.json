{
  "name": "foreman",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.all.json --pretty false",
    "test": "tsx scripts/run-tests.ts \"packages/core/src/**/*.test.ts\" \"packages/event-log/src/**/*.test.ts\" \"packages/policy/src/**/*.test.ts\" \"packages/orchestration/src/**/*.test.ts\" \"packages/graph-store/src/**/*.test.ts\" \"packages/session-store/src/**/*.test.ts\" \"packages/memory/src/**/*.test.ts\" \"packages/launcher/src/**/*.test.ts\" \"scripts/**/*.test.ts\" \"packages/pel/test/**/*.test.ts\" \"packages/providers/src/**/*.test.ts\"",
    "build": "npm run build --workspace @foreman/pel && npm run build --workspace @foreman/providers && tsx scripts/build-runtime.ts",
    "build:appliance-lock": "tsx scripts/appliance-lock.ts --write",
    "verify:appliance-lock": "tsx scripts/appliance-lock.ts --check",
    "verify-runtime": "tsx scripts/verify-runtime.ts",
    "verify": "npm run typecheck && npm run test && npm run verify-runtime && npm run verify:appliance-lock && npm run verify-register-doc && npm run smoke:dst-0060",
    "verify-register-doc": "tsx scripts/verify-register-doc.ts",
    "smoke:dst-0060": "tsx scripts/smoke-dst-0060.ts",
    "policy-check": "node skills/foreman/runtime/dist/architecture-policy.js check",
    "policy:check": "node skills/foreman/runtime/dist/architecture-policy.js check",
    "verify-install": "node skills/foreman/runtime/dist/architecture-policy.js verify-install",
    "plugin-drift": "node skills/foreman/runtime/dist/architecture-policy.js plugin-drift",
    "build:pel": "npm run build --workspace @foreman/pel",
    "test:pel-fixture-build": "tsx scripts/build-pel-test-fixture.ts",
    "pretest": "npm run build --workspace @foreman/pel && npm run build --workspace @foreman/providers && npm run test:pel-fixture-build",
    "pretest:pel-authoring": "npm run build --workspace @foreman/pel && npm run build --workspace @foreman/providers && npm run test:pel-fixture-build",
    "test:pel-authoring": "tsx scripts/run-tests.ts \"packages/pel/test/analysis.test.ts\" \"packages/pel/test/preview.test.ts\" \"packages/pel/test/binding.test.ts\" \"packages/orchestration/src/pel-authoring-cli.test.ts\" \"packages/orchestration/src/pel-generation.test.ts\" \"packages/orchestration/src/pel-draft-session.test.ts\" \"packages/orchestration/src/pel-cli-fixture.test.ts\"",
    "pretest:providers": "npm run build --workspace @foreman/pel && npm run build --workspace @foreman/providers && npm run test:pel-fixture-build",
    "test:providers": "tsx scripts/run-tests.ts \"packages/providers/src/**/*.test.ts\" \"packages/orchestration/src/pel-provider-cli.test.ts\" \"packages/orchestration/src/pel-provider-qualification.test.ts\" \"packages/orchestration/src/pel-provider-list.test.ts\" \"packages/orchestration/src/pel-provider-live.test.ts\" \"packages/orchestration/src/pel-provider-generation-live.test.ts\" \"packages/orchestration/src/pel-provider-list-live.test.ts\" \"packages/orchestration/src/pel-provider-readiness-live.test.ts\""
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "esbuild": "0.27.0",
    "tsx": "4.20.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
