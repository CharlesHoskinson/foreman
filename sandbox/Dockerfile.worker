# Foreman worker image — pinned reference toolchain (WSL2/Docker).
# Model/CLI versions are moving targets: re-verify install commands at build time (spec §11).
FROM ubuntu:26.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      git jq curl ca-certificates python3 python3-pip python3-venv nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# Research/graph toolkit (spec §2.4): Scrapling + Graphify available to the worker offline.
RUN pip3 install --break-system-packages scrapling \
 && git clone --depth 1 https://github.com/Graphify-Labs/graphify /opt/graphify

# Worker CLIs — version-pinned for reproducibility and supply-chain safety.
# Floating `latest` is avoided deliberately: a pinned version can be audited and cannot
# silently pull a newer (or compromised) release into the image. Bump the pins after
# re-verifying (spec §11 — CLI versions are moving targets); override at build time:
#   docker build --build-arg CLAUDE_VER=X --build-arg CODEX_VER=Y --build-arg GROK_VER=Z ...
# Scope provenance verified 2026-07 (npm maintainers):
#   @anthropic-ai/claude-code, @openai/codex, @xai-official/grok (publisher xai-security@x.ai).
# @xai-org/grok-build does NOT exist — do not reintroduce it. The single install command
# has no fallback so a broken pin fails the build loudly instead of dropping a vendor.
ARG CLAUDE_VER=2.1.207
ARG CODEX_VER=0.144.1
ARG GROK_VER=0.2.93
RUN npm install -g \
      "@anthropic-ai/claude-code@${CLAUDE_VER}" \
      "@openai/codex@${CODEX_VER}" \
      "@xai-official/grok@${GROK_VER}"

RUN useradd -m -s /bin/bash worker
USER worker
WORKDIR /workspace
